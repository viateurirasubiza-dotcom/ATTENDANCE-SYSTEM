// 2. IYI NI YO CODE YAWE YARI IHARI (Notifications)
// ============================================
exports.sendGroupChatNotification = functions.firestore
    .document('groupChats/{messageId}')
    .onCreate(async (snap, context) => {
        const message = snap.data();
        const messageId = context.params.messageId;
        
        if (!message.fromUid || !message.message) {
            console.log('⚠️ Message nta fromUid cyangwa message');
            return null;
        }
        
        try {
            // ✅ Bona users BOSE (nta filter ya query)
            const usersSnap = await admin.firestore().collection('users').get();
            
            const tokens = [];
            usersSnap.forEach(doc => {
                const user = doc.data();
                if (user.fcmToken && doc.id !== message.fromUid) {
                    tokens.push(user.fcmToken);
                }
            });
            
            // ✅ Reba NA members (abo batari muri users)
            const membersSnap = await admin.firestore().collection('members').get();
            membersSnap.forEach(doc => {
                const member = doc.data();
                if (member.fcmToken && member.uid && member.uid !== message.fromUid) {
                    // Reba niba token itarasanzwe muri tokens
                    if (!tokens.includes(member.fcmToken)) {
                        tokens.push(member.fcmToken);
                    }
                }
            });
            
            if (tokens.length === 0) {
                console.log('⚠️ Nta FCM token yabonetse');
                return null;
            }
            
            console.log(`📤 Kohereza notification kuri ${tokens.length} users`);
            
            // ✅ Koresha sendEachForMulticast (v12+)
            const response = await admin.messaging().sendEachForMulticast({
                tokens: tokens,
                notification: {
                    title: `💬 ${message.fromName || 'Umuririmbyi'}`,
                    body: message.message.substring(0, 100)
                },
                data: {
                    type: 'group_chat',
                    messageId: messageId,
                    fromUid: message.fromUid,
                    fromName: message.fromName || ''
                },
                webpush: {
                    fcmOptions: {
                        link: '/index.html#chat'
                    },
                    notification: {
                        icon: message.fromPhoto || '/favicon.png',
                        badge: '/favicon.png',
                        tag: 'hcfc-group-chat',
                        requireInteraction: true
                    }
                }
            });
            
            console.log(`✅ Notification yoherejwe: ${response.successCount} success, ${response.failureCount} failed`);
            
            // ✅ Kuraho tokens zitarakora
            if (response.failureCount > 0) {
                const failedTokens = [];
                response.responses.forEach((resp, idx) => {
                    if (!resp.success) {
                        failedTokens.push(tokens[idx]);
                    }
                });
                console.log('❌ Failed tokens:', failedTokens);
            }
            
            return null;
            
        } catch(e) {
            console.error('❌ Notification error:', e);
            return null;
        }
    });
