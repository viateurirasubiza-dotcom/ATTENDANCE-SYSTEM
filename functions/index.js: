// 1. KUBONA TOKEN
async function getMtnToken() {
    const auth = Buffer.from(`${API_USER}:${API_KEY}`).toString('base64');
    const res = await axios.post(`${MTN_BASE}/collection/token/`, {}, {
        headers: {
            'Authorization': `Basic ${auth}`,
            'Ocp-Apim-Subscription-Key': SUB_KEY,
            'X-Target-Environment': 'sandbox'
        }
    });
    return res.data.access_token;
}

// ============================================
// 2. REQUEST TO PAY (IYI NI YO HTML IHAMAGARA)
// ============================================
exports.requestMomoPayment = functions.https.onRequest((req, res) => {
    // Koresha CORS kuri byose (POST na OPTIONS)
    cors(req, res, async () => {
        const { phone, amount, memberId, memberName } = req.body;

        try {
            const token = await getMtnToken();
            const refId = uuidv4();

            await axios.post(`${MTN_BASE}/collection/v1_0/requesttopay`, {
                amount: amount.toString(),
                currency: 'EUR',
                externalId: 'HCFC-' + Date.now(),
                payer: { partyIdType: 'MSISDN', partyId: phone },
                payerMessage: 'Umusanzu wa HCFC',
                payeeNote: 'Murakoze'
            }, {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'X-Reference-Id': refId,
                    'X-Target-Environment': 'sandbox',
                    'Ocp-Apim-Subscription-Key': SUB_KEY
                }
            });

            // Bika muri Firestore nka pending
            await admin.firestore().collection('transactions').doc(refId).set({
                type: 'income',
                amount: parseFloat(amount),
                category: 'contribution',
                description: 'MoMo Payment',
                memberId: memberId || null,
                memberName: memberName || 'Unknown',
                phoneNumber: phone,
                paymentMethod: 'MTN MoMo',
                mtnReferenceId: refId,
                status: 'pending',
                date: new Date().toISOString().split('T')[0],
                createdAt: admin.firestore.FieldValue.serverTimestamp()
            });

            res.json({ success: true, referenceId: refId, message: 'Ubutumwa bwoherejwe kuri telefone yawe. Injiza PIN.' });
        } catch (error) {
            console.error(error.response ? error.response.data : error.message);
            res.status(500).json({ error: error.message });
        }
    });
});

// ============================================
// 3. CALLBACK (IYO UMUKORESHA AMAZE KWISHYURA)
// ============================================
exports.momoCallback = functions.https.onRequest((req, res) => {
    cors(req, res, async () => {
        const { referenceId } = req.body;
        
        try {
            const token = await getMtnToken();
            const statusRes = await axios.get(`${MTN_BASE}/collection/v1_0/requesttopay/${referenceId}`, {
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'X-Target-Environment': 'sandbox',
                    'Ocp-Apim-Subscription-Key': SUB_KEY
                }
            });

            const status = statusRes.data.status;

            if (status === 'SUCCESSFUL') {
                await admin.firestore().collection('transactions').doc(referenceId).update({
                    status: 'confirmed',
                    confirmedAt: admin.firestore.FieldValue.serverTimestamp()
                });
            } else if (status === 'FAILED') {
                await admin.firestore().collection('transactions').doc(referenceId).update({
                    status: 'rejected',
                    mtnStatus: 'FAILED'
                });
            }
            res.sendStatus(200);
        } catch (error) {
            console.error(error);
            res.sendStatus(500);
        }
    });
});

// ============================================
// 4. NOTIFICATIONS (IYO HARI UBUTUMWA BUSHYA MU ITSINDA)
// ============================================
exports.sendGroupChatNotification = functions.firestore
    .document('groupChats/{messageId}')
    .onCreate(async (snap, context) => {
        const message = snap.data();
        const messageId = context.params.messageId;
        
        if (!message.fromUid || !message.message) return null;
        
        try {
            const usersSnap = await admin.firestore().collection('users').get();
            const tokens = [];
            usersSnap.forEach(doc => {
                const user = doc.data();
                if (user.fcmToken && doc.id !== message.fromUid) {
                    tokens.push(user.fcmToken);
                }
            });
            
            const membersSnap = await admin.firestore().collection('members').get();
            membersSnap.forEach(doc => {
                const member = doc.data();
                if (member.fcmToken && member.uid && member.uid !== message.fromUid) {
                    if (!tokens.includes(member.fcmToken)) {
                        tokens.push(member.fcmToken);
                    }
                }
            });
            
            if (tokens.length === 0) return null;
            
            const response = await admin.messaging().sendEachForMulticast({
                tokens: tokens,
                notification: {
                    title: `💬 ${message.fromName || 'Umuririmbyi'}`,
                    body: message.message.substring(0, 100)
                },
                data: {
                    type: 'group_chat',
                    messageId: messageId,
                    fromUid: message.fromUid,
                    fromName: message.fromName || ''
                },
                webpush: {
                    fcmOptions: { link: '/index.html#chat' },
                    notification: {
                        icon: message.fromPhoto || '/favicon.png',
                        badge: '/favicon.png',
                        tag: 'hcfc-group-chat',
                        requireInteraction: true
                    }
                }
            });
            
            return null;
        } catch(e) {
            console.error('❌ Notification error:', e);
            return null;
        }
    });
